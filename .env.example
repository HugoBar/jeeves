# Running Jeeves with docker compose (see README.md)
# Password for the database docker-compose.yml creates. Letters and digits only.
POSTGRES_PASSWORD=
# Port Jeeves is served on (optional).
PORT=3000

# Development: the database `pnpm db:up` starts. docker-compose.yml ignores it.
DATABASE_URL=postgres://jeeves:jeeves@localhost:5432/jeeves
